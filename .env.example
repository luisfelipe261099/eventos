# ==========================================================
# VipFlow — variáveis de ambiente
# Sem nenhuma delas, o app roda em MODO DEMO (dados de exemplo).
# Na Vercel: Project → Settings → Environment Variables
# ==========================================================

# --- Banco ---
# Integração Supabase da Vercel (Storage → Supabase) cria estas automaticamente:
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
# (nomes manuais também aceitos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA: Google Gemini (grátis: aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Pagamentos Pix: Asaas (taxa por Pix recebido, sem mensalidade) ---
# Asaas → Integrações → Chaves de API. $aact_hmlg_... = Sandbox (testes); $aact_prod_... = produção.
# Sem esta chave, os pagamentos são aprovados automaticamente (modo teste).
ASAAS_API_KEY=
# Opcional: força o ambiente (sandbox | production). Por padrão é detectado pelo prefixo da chave.
ASAAS_ENV=
# Opcional: comissão da VipFlow descontada de cada venda (split)
ASAAS_SPLIT_WALLET_ID=
ASAAS_SPLIT_PERCENT=5

# --- Segurança ---
# Protege a rota de cron (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Senha simples do painel admin enquanto o login Supabase não é ativado
ADMIN_PASSWORD=

# URL pública do app (para links de convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WhatsApp (opcional) ---
# Sem isso, o sistema gera links wa.me para enviar com 1 toque (grátis).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

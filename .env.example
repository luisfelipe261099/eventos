# ==========================================================
# Casa Cheia — variáveis de ambiente
# Sem nenhuma delas, o app roda em MODO DEMO (dados de exemplo).
# Na Vercel: Project → Settings → Environment Variables
# ==========================================================

# --- Banco ---
# Integração Supabase da Vercel (Storage → Supabase) cria estas automaticamente:
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_URL=
# (nomes manuais também aceitos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. NUNCA exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# --- IA: Google Gemini (grátis: aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Pagamentos: Asaas ---
# Cada casa cola a PRÓPRIA chave de API em /admin/setup (fica cifrada no banco).
# Estas duas são da conta Asaas DA CASA CHEIA, para receber das casas:
# walletId da Casa Cheia: a taxa de cada ingresso sai do Pix pelo split.
ASAAS_SPLIT_WALLET_ID=
# Chave de API da Casa Cheia: cobra a mensalidade das casas (Pix, boleto ou cartão).
VIPFLOW_ASAAS_API_KEY=
# Opcional: força o ambiente sandbox para todas as chaves.
ASAAS_ENV=
# Só para desenvolvimento: aprova pagamentos na hora, sem Asaas.
PAYMENTS_TEST_MODE=

# --- Segurança ---
# Protege a rota de cron (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Senha da plataforma (Casa Cheia): entra em /plataforma e abre o painel de qualquer casa
ADMIN_PASSWORD=
# Assina as sessões e cifra as chaves do Asaas das casas. Não troque depois de ter casas cadastradas.
SESSION_SECRET=

# URL pública do app (para links de convite)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- WhatsApp (opcional) ---
# Sem isso, o sistema gera links wa.me para enviar com 1 toque (grátis).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
